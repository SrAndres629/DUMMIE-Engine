{
  "gateway_name": "shell",
  "port": 8085,
  "capability_class": "shell_automation",
  "mcp_servers": {
    "shell": {
      "command": "npx",
      "args": ["-y", "mcp-shell"]
    },
    "mcp-bash": {
      "command": "mcp-bash-server",
      "args": []
    },
    "browser-use": {
      "command": "uvx",
      "args": ["--from", "browser-use[cli]", "browser-use", "--mcp"]
    }
  }
}
