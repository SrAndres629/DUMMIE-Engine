{
  "version": "2.0.0",
  "comment": "Solo modelos locales especializados. Zero dependencia cloud. Optimizado para RTX 3060 6GB + i9-11900H 15GB RAM.",
  "defaults": {
    "llm": "gemma4:e2b",
    "embedding": "granite-embedding:30m",
    "reranker": "qwen3.5:0.8b",
    "classifier": "smollm:360m",
    "reasoning": "smallthinker:3b"
  },
  "providers": {
    "ollama": {
      "host": "http://localhost:11434",
      "models": {
        "gemma4:e2b": {
          "type": "llm",
          "provider": "ollama",
          "context_length": 8192,
          "priority": "HIGH"
        },
        "gemma4:e4b": {
          "type": "llm",
          "provider": "ollama",
          "context_length": 16384,
          "priority": "MEDIUM"
        },
        "gemma3:1b": {
          "type": "llm",
          "provider": "ollama",
          "context_length": 8192,
          "priority": "LOW"
        },
        "granite-embedding:30m": {
          "type": "embedding",
          "provider": "ollama",
          "dimensions": 384,
          "size_mb": 60,
          "priority": "CRITICAL"
        },
        "granite-embedding:278m": {
          "type": "embedding",
          "provider": "ollama",
          "dimensions": 768,
          "size_mb": 550,
          "priority": "HIGH"
        },
        "qwen3-embedding:0.6b": {
          "type": "embedding",
          "provider": "ollama",
          "dimensions": 1024,
          "size_mb": 1200,
          "priority": "MEDIUM"
        },
        "smollm:360m": {
          "type": "classifier",
          "provider": "ollama",
          "context_length": 2048,
          "size_mb": 300,
          "priority": "CRITICAL"
        },
        "smollm:1.7b": {
          "type": "classifier",
          "provider": "ollama",
          "context_length": 4096,
          "size_mb": 1300,
          "priority": "HIGH"
        },
        "qwen3.5:0.8b": {
          "type": "reranker",
          "provider": "ollama",
          "context_length": 4096,
          "size_mb": 1200,
          "priority": "CRITICAL"
        },
        "smallthinker:3b": {
          "type": "reasoning",
          "provider": "ollama",
          "context_length": 8192,
          "size_mb": 2500,
          "priority": "CRITICAL"
        },
        "qwen3.5:4b": {
          "type": "reasoning",
          "provider": "ollama",
          "context_length": 16384,
          "size_mb": 3300,
          "priority": "HIGH"
        }
      }
    },
    "fastembed": {
      "models": {
        "BAAI/bge-small-en-v1.5": {
          "type": "embedding",
          "provider": "fastembed",
          "dimensions": 384,
          "priority": "HIGH"
        },
        "BAAI/bge-base-en-v1.5": {
          "type": "embedding",
          "provider": "fastembed",
          "dimensions": 768,
          "priority": "LOW"
        }
      }
    },
    "sentence_transformers": {
      "models": {
        "cross-encoder/ms-marco-MiniLM-L-2-v2": {
          "type": "reranker",
          "provider": "sentence_transformers",
          "priority": "MEDIUM"
        }
      }
    }
  },
  "adapter_map": {
    "ollama": "dummie_sdk.models.adapters.ollama_adapter.OllamaAdapter",
    "fastembed": "dummie_sdk.models.adapters.fastembed_adapter.FastEmbedAdapter",
    "sentence_transformers": "dummie_sdk.models.adapters.cross_encoder_adapter.CrossEncoderAdapter",
    "ollama_embedding": "dummie_sdk.models.adapters.ollama_adapter.OllamaAdapter"
  },
  "lifecycle": {
    "ttl_seconds": {
      "llm": 300,
      "embedding": 600,
      "reranker": 600
    },
    "vram_threshold_mb": 2048
  }
}
