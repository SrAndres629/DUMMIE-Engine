[Unit]
Description=DUMMIE Engine Factory Supervisor
After=network.target

[Service]
Type=simple
# We run the supervisor directly rather than through factory_up.sh
# so systemd can track the PID perfectly.
ExecStart=/bin/bash -c 'DUMMIE_ROOT="%h/Escritorio/DUMMIE Engine" DUMMIE_AIWG_DIR="%h/Escritorio/DUMMIE Engine/.aiwg" "%h/Escritorio/DUMMIE Engine/layers/l2_brain/.venv/bin/python" "%h/Escritorio/DUMMIE Engine/layers/l0_overseer/supervisor.py"'
WorkingDirectory=%h/Escritorio/DUMMIE Engine
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

# Graceful termination
KillSignal=SIGTERM
TimeoutStopSec=15

[Install]
WantedBy=default.target
