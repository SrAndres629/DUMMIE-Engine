#!/usr/bin/env python3
import sys
import subprocess
import json
from pathlib import Path

# Setup paths
ROOT = Path(__file__).resolve().parents[1]
sys.path.append(str(ROOT))
sys.path.append(str(ROOT / "layers" / "l2_brain"))

def run_python(module_path, args):
    cmd = [sys.executable, str(ROOT / module_path)] + args
    return subprocess.run(cmd, capture_output=False)

def show_help():
    print("DUMMIE Engine Control Utility (dummie-ctl)")
    print("Usage: dummie-ctl <command> [args]")
    print("\nCommands:")
    print("  status                 Show system status and phase")
    print("  whoami                 Identify DUMMIE operational identity")
    print("  identity               Print creator profile and identity details")
    print("  chat <text>            Runtime chat (preprocess + routing + lifecycle trace)")
    print("  advise <text>          Get strategic advice for business growth or goals")
    print("  strategy <text>        Shortcut for advise")
    print("  business               Show the latest business intake structure")
    print("  goals                  List goals in goal memory")
    print("  goals add <text>       Add a goal to goal memory")
    print("  memory                 Show memory status and details")
    print("  providers              List provider configurations")
    print("  providers check        Check live provider authorization status")
    print("  agent-boot             Boot agent environment")
    print("  guarded-run <text>     Run command under guarded validation policy")
    print("  calibrate              Run sovereign readiness calibration")
    print("  triage                 Show test debt triage report")
    print("  heartbeat              Execute manual observe-only heartbeat cycle")
    print("  heartbeat-dry-run      Perform simulated dry-run heartbeat cycle")
    print("  heartbeat-status       Show status of last recorded heartbeat")
    print("  next-heartbeat         Show next heartbeat seed information")
    print("  scan                   Run whole-body scan and shadow detector")
    print("  scan-calibration       Calibrate whole-body scan metrics against pytest and reports")
    print("  wiring-matrix          Construct directed module dependency wiring matrix")
    print("  shadow-runtime         Safely audit and classify shadow (unwired) Python modules")
    print("  systemic-coherence     Display current systemic coherence percentage")
    print("  circulation            Execute context circulation orchestrator")
    print("  6d-context             Build six-dimensional context packet")
    print("  context-optimize       Build optimized strategy comparison for context packet")
    print("  embedding-router       Seed offline search router directory maps")
    print("  4dtes-preflight        Verify Kùzu/memory spine schema readiness checks")
    print("  daemon-gateway-bridge  Formulate gateway safe-dispatch contract packages")
    print("  polyglot-probe         Compile multi-language file extension manifest")
    print("  dependency-audit       Inspect Python package import diagnostic data structure")
    print("  degraded-capabilities  Consolidate central capability status mappings")
    print("  toolchain-probe        Query host multi-language command probes")
    print("  runtime-closure-plan   Generate human-approval gated closure action plans")
    print("  model-bootstrap        Bootstrap OpenCode + local fallback model stack")
    print("  token-snapshot         Generate current token+embedding realtime snapshot")
    print("  token-live [seconds]   Continuously refresh token+embedding realtime snapshot")
    print("  spec-registry-sync     Rebuild canonical spec binding registry from doc/specs")
    print("  help                   Show this help")

def main():
    if len(sys.argv) < 2:
        show_help()
        return

    cmd = sys.argv[1].lower()
    args = sys.argv[2:]

    # Route sovereign CLI commands
    sovereign_cmds = ("whoami", "identity", "advise", "strategy", "business", "goals", "memory", "providers", "agent-boot", "guarded-run")
    
    if cmd == "status":
        if "--l2" in args:
            args.remove("--l2")
            run_python("layers/l2_brain/dummie_chat_cli.py", ["status"])
        else:
            cmd_run = [sys.executable, "-m", "dummie", "status"] + args
            subprocess.run(cmd_run)
    elif cmd in sovereign_cmds:
        cmd_run = [sys.executable, "-m", "dummie", cmd] + args
        subprocess.run(cmd_run)
    elif cmd == "chat":
        if not args:
            print("Error: chat requires query text")
            return
        # Route through sovereign advisor
        cmd_run = [sys.executable, "-m", "dummie", "chat"] + args
        subprocess.run(cmd_run)
    elif cmd == "calibrate":
        run_python("layers/l2_brain/cli_control_plane.py", ["readiness-calibration"])
    elif cmd == "triage":
        triage_md = ROOT / ".aiwg" / "reports" / "test_debt_triage_latest.md"
        if triage_md.exists():
            print(triage_md.read_text())
        else:
            print("Triage report not found. Run tests first.")
    elif cmd == "heartbeat":
        run_python("layers/l2_brain/cli_control_plane.py", ["heartbeat"])
    elif cmd == "heartbeat-dry-run":
        run_python("layers/l2_brain/cli_control_plane.py", ["heartbeat-dry-run"])
    elif cmd == "heartbeat-status":
        run_python("layers/l2_brain/cli_control_plane.py", ["heartbeat-status"])
    elif cmd == "next-heartbeat":
        run_python("layers/l2_brain/cli_control_plane.py", ["heartbeat-seed"])
    elif cmd == "scan":
        run_python("layers/l2_brain/cli_control_plane.py", ["whole-body-scan"])
    elif cmd == "scan-calibration":
        run_python("layers/l2_brain/cli_control_plane.py", ["scan-calibration"])
    elif cmd == "wiring-matrix":
        run_python("layers/l2_brain/cli_control_plane.py", ["wiring-matrix"])
    elif cmd == "shadow-runtime":
        run_python("layers/l2_brain/cli_control_plane.py", ["shadow-runtime"])
    elif cmd == "systemic-coherence":
        run_python("layers/l2_brain/cli_control_plane.py", ["systemic-coherence"])
    elif cmd == "circulation":
        run_python("layers/l2_brain/cli_control_plane.py", ["context-circulation"])
    elif cmd == "6d-context":
        run_python("layers/l2_brain/cli_control_plane.py", ["6d-context"])
    elif cmd == "context-optimize":
        run_python("layers/l2_brain/cli_control_plane.py", ["context-optimize"])
    elif cmd == "embedding-router":
        run_python("layers/l2_brain/cli_control_plane.py", ["embedding-router"])
    elif cmd == "4dtes-preflight":
        run_python("layers/l2_brain/cli_control_plane.py", ["4dtes-preflight"])
    elif cmd == "daemon-gateway-bridge":
        run_python("layers/l2_brain/cli_control_plane.py", ["daemon-gateway-bridge"])
    elif cmd == "polyglot-probe":
        run_python("layers/l2_brain/cli_control_plane.py", ["polyglot-probe"])
    elif cmd == "dependency-audit":
        run_python("layers/l2_brain/cli_control_plane.py", ["dependency-audit"])
    elif cmd == "degraded-capabilities":
        run_python("layers/l2_brain/cli_control_plane.py", ["degraded-capabilities"])
    elif cmd == "toolchain-probe":
        run_python("layers/l2_brain/cli_control_plane.py", ["toolchain-probe"])
    elif cmd == "runtime-closure-plan":
        run_python("layers/l2_brain/cli_control_plane.py", ["runtime-closure-plan"])
    elif cmd == "model-bootstrap":
        run_python("scripts/dummie_model_bootstrap.py", args)
    elif cmd == "token-snapshot":
        run_python("scripts/dummie_token_embedding_monitor.py", args)
    elif cmd == "token-live":
        interval = "10"
        if args:
            interval = args[0]
        run_python("scripts/dummie_token_embedding_monitor.py", ["--watch", "--interval", interval])
    elif cmd == "spec-registry-sync":
        run_python("scripts/spec_registry_sync.py", args)
    elif cmd == "help":
        show_help()
    else:
        print(f"Unknown command: {cmd}")
        show_help()

if __name__ == "__main__":
    main()
