[Unit]
Description=DUMMIE Sovereign Memory Daemon — Kuzu/Arrow Flight IPC
Documentation=https://dummie.ai
After=network.target

[Service]
Type=simple
User=jorand
Environment=DUMMIE_ROOT=/opt/dummie-engine
User=jorand
Environment=DUMMIE_AIWG_DIR=/opt/dummie-engine/.aiwg
User=jorand
Environment=DUMMIE_KUZU_DB_PATH=/opt/dummie-engine/.aiwg/memory/loci.db
User=jorand
Environment=MEMORY_SOCKET_PATH=/opt/dummie-engine/.aiwg/sockets/flight.sock
WorkingDirectory=/opt/dummie-engine

ExecStartPre=/bin/bash -c "mkdir -p '/opt/dummie-engine/.aiwg/memory' '/opt/dummie-engine/.aiwg/sockets'"
ExecStartPre=/bin/bash -c "rm -f '/opt/dummie-engine/.aiwg/memory/loci.db'/*.lock"
ExecStart=/opt/dummie-engine/layers/l1_nervous/bin/memory_server

Restart=on-failure
RestartSec=5

KillSignal=SIGTERM
TimeoutStopSec=15
SendSIGKILL=yes

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
