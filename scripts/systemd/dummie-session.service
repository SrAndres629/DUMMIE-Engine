[Unit]
Description=DUMMIE Session Daemon — opencode lifecycle + model watch + heartbeat
After=network.target dummie-engine.service dummie-opencode.service
Wants=dummie-engine.service dummie-opencode.service

[Service]
Type=simple
User=jorand
WorkingDirectory=/opt/dummie-engine
ExecStart=/home/jorand/.local/bin/uv run python -m dummie_sdk.daemon.session_daemon
ExecStop=/bin/kill -TERM $MAINPID
Restart=always
RestartSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=dummie-session
Environment=PATH=/home/jorand/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=DUMMIE_ROOT=/opt/dummie-engine

SuccessExitStatus=143

[Install]
WantedBy=default.target
