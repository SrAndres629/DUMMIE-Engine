[Unit]
Description=DUMMIE Models Pull — autonomous Ollama model download daemon
Documentation=https://dummie.ai
After=network.target ollama.service
Wants=ollama.service

[Service]
Type=oneshot
User=jorand
Environment=DUMMIE_ROOT=/opt/dummie-engine
Environment=HOME=/home/jorand
Environment=PYTHONUNBUFFERED=1
Environment=PATH=/home/jorand/.local/bin:/usr/local/bin:/usr/bin:/bin
WorkingDirectory=/opt/dummie-engine/layers/l1_nervous

ExecStart=/home/jorand/.local/bin/uv run python -m dummie_sdk.daemon.models_pull

StandardOutput=journal
StandardError=journal
