[Unit]
Description=DUMMIE MetaGateway — 5 sub-gateways + router + delegation
Documentation=https://dummie.ai
After=network.target dummie-memory.service
Wants=dummie-memory.service

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=DUMMIE_ROOT=/opt/dummie-engine
Environment=DUMMIE_AIWG_DIR=/opt/dummie-engine/.aiwg
Environment=PYTHONUNBUFFERED=1
Environment=PATH=/home/jorand/.local/bin:/usr/local/bin:/usr/bin:/bin
WorkingDirectory=/opt/dummie-engine/layers/l1_nervous

ExecStart=/bin/bash "/opt/dummie-engine/scripts/start_metagateway.sh"
ExecStop=/bin/bash -c "pkill -f 'gateway/(media|code|infra|knowledge|shell)_gateway.py' 2>/dev/null; rm -f '/opt/dummie-engine/.aiwg/runtime/gateways'/*"

Restart=on-failure
RestartSec=10

KillMode=process
KillSignal=SIGTERM
TimeoutStopSec=30
SendSIGKILL=yes

[Install]
WantedBy=default.target
