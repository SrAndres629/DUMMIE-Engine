{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RepoProbeResult",
  "type": "object",
  "required": ["decision", "findings", "layer_summary", "language_summary", "runtime_summary", "generated_at"],
  "properties": {
    "decision": { "type": "string", "enum": ["PASS", "PASS_WITH_WARNINGS", "FAIL"] },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["probe_id", "severity", "message"],
        "properties": {
          "probe_id": { "type": "string" },
          "severity": { "type": "string", "enum": ["PASS", "WARNING", "ERROR"] },
          "message": { "type": "string" },
          "evidence": { "type": ["object", "array", "string", "number", "null"] }
        }
      }
    },
    "layer_summary": { "type": "object" },
    "language_summary": { "type": "object" },
    "runtime_summary": { "type": "object" },
    "recommended_actions": { "type": "array", "items": { "type": "string" } },
    "generated_at": { "type": "string", "format": "date-time" }
  }
}
