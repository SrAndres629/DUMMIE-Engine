{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GraphSyncPlan",
  "type": "object",
  "required": ["sync_id", "mode", "source_refs", "nodes", "edges", "created_at"],
  "properties": {
    "sync_id": { "type": "string" },
    "mode": { "type": "string", "enum": ["apply", "validate"] },
    "source_refs": { "type": "array", "items": { "type": "string" } },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["node_id", "node_type", "memory_ref_id"],
        "properties": {
          "node_id": { "type": "string" },
          "node_type": { "type": "string" },
          "memory_ref_id": { "type": "string" },
          "mission_id": { "type": "string" },
          "phase_id": { "type": "string" },
          "content_hash": { "type": "string" },
          "properties": { "type": "object" }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["edge_id", "source", "target", "edge_type"],
        "properties": {
          "edge_id": { "type": "string" },
          "source": { "type": "string" },
          "target": { "type": "string" },
          "edge_type": { "type": "string" },
          "properties": { "type": "object" }
        }
      }
    },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "blocked": { "type": "boolean" },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
