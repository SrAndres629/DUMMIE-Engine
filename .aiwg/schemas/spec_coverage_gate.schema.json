{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dummie.aiwg/schemas/spec_coverage_gate.schema.json",
  "title": "DUMMIE Spec Coverage Gate",
  "type": "object",
  "required": [
    "plan",
    "phase",
    "generated_from_commit",
    "coverage_summary",
    "spec_families",
    "layer_coverage",
    "language_coverage",
    "capability_coverage",
    "test_linkage",
    "known_debt",
    "gate_decision",
    "coverage_thresholds"
  ],
  "properties": {
    "plan": {"type": "string"},
    "phase": {"type": "string"},
    "generated_from_commit": {"type": "string"},
    "coverage_summary": {"type": "object"},
    "spec_families": {"type": "array"},
    "layer_coverage": {"type": "array"},
    "language_coverage": {"type": "array"},
    "capability_coverage": {"type": "array"},
    "test_linkage": {"type": "array"},
    "known_debt": {"type": "array"},
    "gate_decision": {"type": "object"},
    "coverage_thresholds": {"type": "object"}
  }
}
