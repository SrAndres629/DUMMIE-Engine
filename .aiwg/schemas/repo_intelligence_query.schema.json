{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RepoIntelligenceQueryResult",
  "type": "object",
  "required": ["query", "results", "count", "generated_at"],
  "properties": {
    "query": { "type": "object" },
    "results": { "type": "array" },
    "count": { "type": "integer" },
    "decision": { "type": "string" },
    "generated_at": { "type": "string", "format": "date-time" }
  }
}
