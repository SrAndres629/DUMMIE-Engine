{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MentalModelTruthHygiene",
  "type": "object",
  "required": [
    "decision",
    "models_scanned",
    "findings",
    "summary"
  ],
  "properties": {
    "decision": {
      "type": "string",
      "enum": [
        "PASS",
        "PASS_WITH_WARNINGS",
        "FAIL"
      ]
    },
    "models_scanned": {
      "type": "integer"
    },
    "valid_count": {
      "type": "integer"
    },
    "quarantined_count": {
      "type": "integer"
    },
    "findings": {
      "type": "array"
    },
    "summary": {
      "type": "object"
    }
  }
}