{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ShadowRuntimeClassification",
  "type": "OBJECT",
  "properties": {
    "classification_id": { "type": "STRING" },
    "timestamp": { "type": "STRING" },
    "decision": { "type": "STRING", "enum": ["PASS", "PASS_WITH_WARNINGS", "FAIL"] },
    "findings": {
      "type": "ARRAY",
      "items": {
        "type": "OBJECT",
        "properties": {
          "path": { "type": "STRING" },
          "classification": { "type": "STRING", "enum": [
            "cli_entrypoint",
            "script_entrypoint",
            "dynamic_import_candidate",
            "test_only_support",
            "legacy_candidate",
            "orphan_candidate",
            "generated_or_build_artifact",
            "documentation_support",
            "needs_manual_review",
            "safe_to_ignore"
          ] },
          "confidence": { "type": "NUMBER" },
          "why_shadow": { "type": "STRING" },
          "evidence_refs": { "type": "ARRAY", "items": { "type": "STRING" } },
          "recommended_action": { "type": "STRING", "enum": ["wire", "test", "spec", "archive", "ignore", "manual_review", "do_not_touch"] }
        },
        "required": ["path", "classification", "confidence", "why_shadow", "evidence_refs", "recommended_action"]
      }
    },
    "warnings": {
      "type": "ARRAY",
      "items": { "type": "STRING" }
    }
  },
  "required": ["classification_id", "timestamp", "decision", "findings", "warnings"]
}
