{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StaleMemoryReport",
  "type": "object",
  "required": [
    "generated_at",
    "findings",
    "summary"
  ],
  "properties": {
    "generated_at": {
      "type": "string"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "artifact_id",
          "finding_type",
          "severity",
          "message"
        ],
        "properties": {
          "artifact_id": {
            "type": "string"
          },
          "finding_type": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ]
          },
          "message": {
            "type": "string"
          },
          "artifact_path": {
            "type": "string"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "summary": {
      "type": "object"
    }
  }
}
