{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WholeBodyScanCalibration",
  "type": "OBJECT",
  "properties": {
    "calibration_id": { "type": "STRING" },
    "timestamp": { "type": "STRING" },
    "decision": { "type": "STRING", "enum": ["PASS", "PASS_WITH_WARNINGS", "FAIL"] },
    "scan_metrics": {
      "type": "OBJECT",
      "properties": {
        "active_modules": { "type": "INTEGER" },
        "shadow_modules": { "type": "INTEGER" },
        "orphaned_tests": { "type": "INTEGER" },
        "stale_reports": { "type": "INTEGER" },
        "unvalidated_specs": { "type": "INTEGER" }
      },
      "required": ["active_modules", "shadow_modules", "orphaned_tests", "stale_reports", "unvalidated_specs"]
    },
    "reproducibility": {
      "type": "OBJECT",
      "properties": {
        "runtime_seconds": { "type": "NUMBER" },
        "reproducibility_hash": { "type": "STRING" },
        "freshness_timestamp": { "type": "STRING" }
      },
      "required": ["runtime_seconds", "reproducibility_hash", "freshness_timestamp"]
    },
    "test_reconciliation": {
      "type": "OBJECT",
      "properties": {
        "suite_total_tests": { "type": "INTEGER" },
        "reconciled": { "type": "BOOLEAN" },
        "explanation": { "type": "STRING" }
      },
      "required": ["suite_total_tests", "reconciled", "explanation"]
    },
    "warnings": {
      "type": "ARRAY",
      "items": { "type": "STRING" }
    },
    "evidence_refs": {
      "type": "ARRAY",
      "items": { "type": "STRING" }
    }
  },
  "required": ["calibration_id", "timestamp", "decision", "scan_metrics", "reproducibility", "test_reconciliation", "warnings", "evidence_refs"]
}
