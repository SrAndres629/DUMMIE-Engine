{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DUMMIE Mental Model",
  "type": "object",
  "required": ["id", "name", "purpose"],
  "properties": {
    "id": {"type": "string", "pattern": "^MM-[0-9]{3}$"},
    "name": {"type": "string"},
    "purpose": {"type": "string"},
    "source_refs": {"type": "array", "items": {"type": "string"}},
    "status": {"enum": ["active", "planned", "deferred"]}
  }
}

