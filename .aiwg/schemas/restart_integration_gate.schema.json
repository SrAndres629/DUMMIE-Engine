{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RestartIntegrationGateResult",
  "type": "object",
  "required": [
    "decision",
    "checks",
    "failures",
    "warnings",
    "generated_at"
  ],
  "properties": {
    "decision": {
      "type": "string",
      "enum": [
        "PASS",
        "PASS_WITH_WARNINGS",
        "FAIL"
      ]
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "failures": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "generated_at": {
      "type": "string"
    }
  }
}
