{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CapabilityPromotionGovernor",
  "type": "object",
  "properties": {
    "decision": {
      "type": "string",
      "enum": ["PASS", "PASS_WITH_WARNINGS", "FAIL"]
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "capability_id": { "type": "string" },
          "previous_status": { "type": "string" },
          "verified_status": {
            "type": "string",
            "enum": ["READY", "READY_CANDIDATE", "SANDBOX_READY", "FALLBACK", "DEGRADED", "UNKNOWN"]
          },
          "promotion_allowed": { "type": "boolean" },
          "promotion_reason": { "type": "string" },
          "blocking_findings": {
            "type": "array",
            "items": { "type": "string" }
          },
          "required_next_verification": {
            "type": "array",
            "items": { "type": "string" }
          },
          "evidence_refs": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "required": [
          "capability_id",
          "previous_status",
          "verified_status",
          "promotion_allowed",
          "promotion_reason",
          "blocking_findings",
          "required_next_verification",
          "evidence_refs"
        ]
      }
    }
  },
  "required": [
    "decision",
    "capabilities"
  ]
}
