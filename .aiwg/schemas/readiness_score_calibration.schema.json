{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ReadinessScoreCalibrationReport",
  "type": "object",
  "required": ["decision", "calibrated_scores", "findings", "generated_at"],
  "properties": {
    "decision": { "type": "string", "enum": ["PASS", "PASS_WITH_WARNINGS", "FAIL"] },
    "calibrated_scores": {
      "type": "object",
      "properties": {
        "daily_use_readiness": { "type": "number", "minimum": 0, "maximum": 10 },
        "memory_spine_readiness": { "type": "number", "minimum": 0, "maximum": 10 },
        "token_economy_readiness": { "type": "number", "minimum": 0, "maximum": 10 },
        "entrypoint_sovereignty_readiness": { "type": "number", "minimum": 0, "maximum": 10 },
        "autonomy_readiness": { "type": "number", "minimum": 0, "maximum": 10 }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "severity", "description", "impact", "score_penalty"],
        "properties": {
          "id": { "type": "string" },
          "severity": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
          "description": { "type": "string" },
          "impact": { "type": "string" },
          "score_penalty": { "type": "number" }
        }
      }
    },
    "generated_at": { "type": "string" }
  }
}
