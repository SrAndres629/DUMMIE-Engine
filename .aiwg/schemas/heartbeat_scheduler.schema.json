{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HeartbeatScheduler",
  "type": "object",
  "required": [
    "type",
    "decision",
    "timestamp"
  ],
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "apply",
        "run_once"
      ]
    },
    "heartbeat_id": {
      "type": "string"
    },
    "decision": {
      "type": "string"
    },
    "timestamp": {
      "type": "string"
    }
  }
}