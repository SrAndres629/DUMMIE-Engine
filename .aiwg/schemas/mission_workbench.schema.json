{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MissionWorkbenchManifest",
  "type": "object",
  "properties": {
    "mission_id": { "type": "string" },
    "session_id": { "type": "string" },
    "user_goal": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "status": { 
      "type": "string", 
      "enum": ["active", "finalized", "aborted"] 
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "kind": { "type": "string" },
          "checksum": { "type": "string" }
        }
      }
    }
  },
  "required": ["mission_id", "session_id", "user_goal", "created_at", "status"]
}
