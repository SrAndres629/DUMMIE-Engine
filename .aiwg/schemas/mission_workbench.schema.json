{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MissionWorkbench",
  "type": "object",
  "required": ["mission_id", "user_goal", "created_at"],
  "properties": {
    "mission_id": { "type": "string" },
    "user_goal": { "type": "string" },
    "phase_id": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "status": { "type": "string", "enum": ["active", "finalized", "archived"] },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "kind": { "type": "string" },
          "ref": { "type": "string" },
          "created_at": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}
