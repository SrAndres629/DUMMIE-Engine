{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RepoIntelligenceManifest",
  "type": "object",
  "required": ["repo_id", "tracked_files_count", "layers_detected", "languages_detected", "generated_at"],
  "properties": {
    "repo_id": { "type": "string" },
    "tracked_files_count": { "type": "integer" },
    "layers_detected": { "type": "array", "items": { "type": "string" } },
    "languages_detected": { "type": "array", "items": { "type": "string" } },
    "risk_flags": { "type": "array", "items": { "type": "string" } },
    "generated_at": { "type": "string", "format": "date-time" }
  }
}
