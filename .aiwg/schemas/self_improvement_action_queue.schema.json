{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SelfImprovementActionQueue",
  "type": "object",
  "required": [
    "actions"
  ],
  "properties": {
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "action_id",
          "action_type",
          "priority",
          "status"
        ]
      }
    },
    "blocked": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next": {
      "type": "string"
    }
  }
}