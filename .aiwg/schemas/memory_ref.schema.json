{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MemoryRef",
  "type": "object",
  "required": ["memory_ref_id", "ref_type", "path", "content_hash", "created_at"],
  "properties": {
    "memory_ref_id": { "type": "string" },
    "ref_type": { 
      "type": "string", 
      "enum": ["learning_episode", "vault_entry", "workbench", "phase_event", "token_ledger", "daemon_outcome"] 
    },
    "session_id": { "type": "string" },
    "mission_id": { "type": "string" },
    "phase_id": { "type": "string" },
    "path": { "type": "string" },
    "content_hash": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "kuzu_ready": { "type": "boolean" },
    "embedding_ready": { "type": "boolean" }
  }
}
