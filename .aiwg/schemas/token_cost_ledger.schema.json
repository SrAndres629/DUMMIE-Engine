{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TokenCostLedgerEvent",
  "type": "object",
  "required": ["event_id", "source", "timestamp"],
  "properties": {
    "event_id": { "type": "string" },
    "session_id": { "type": "string" },
    "mission_id": { "type": "string" },
    "phase_id": { "type": "string" },
    "model_tier": { 
      "type": "string",
      "enum": ["deterministic", "local_fast", "local_deep", "cloud_std", "cloud_prem"]
    },
    "provider": { "type": "string" },
    "source": { 
      "type": "string",
      "enum": ["router", "metagateway", "outcome", "manual", "provider_response"]
    },
    "input_tokens": { "type": "integer", "minimum": 0 },
    "cached_tokens": { "type": "integer", "minimum": 0 },
    "output_tokens": { "type": "integer", "minimum": 0 },
    "reasoning_tokens": { "type": "integer", "minimum": 0 },
    "estimated": { "type": "boolean" },
    "timestamp": { "type": "string", "format": "date-time" }
  }
}
