{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TokenUsageEvent",
  "type": "object",
  "properties": {
    "event_id": { "type": "string" },
    "session_id": { "type": "string" },
    "mission_id": { "type": "string" },
    "model_tier": { 
      "type": "string",
      "enum": ["local_fast", "local_deep", "cloud_std", "cloud_prem", "deterministic"]
    },
    "provider": { "type": "string" },
    "input_tokens": { "type": "integer", "minimum": 0 },
    "cached_tokens": { "type": "integer", "minimum": 0 },
    "output_tokens": { "type": "integer", "minimum": 0 },
    "reasoning_tokens": { "type": "integer", "minimum": 0 },
    "estimated": { "type": "boolean" },
    "source": { 
      "type": "string",
      "enum": ["router", "metagateway", "manual", "provider_response"]
    },
    "timestamp": { "type": "string", "format": "date-time" }
  },
  "required": ["event_id", "session_id", "input_tokens", "output_tokens", "timestamp"]
}
