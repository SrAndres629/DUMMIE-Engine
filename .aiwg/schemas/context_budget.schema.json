{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ContextBudget",
  "type": "object",
  "required": ["total_budget", "tiers"],
  "properties": {
    "total_budget": { "type": "integer", "minimum": 0 },
    "tiers": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "critical_preserved": { "type": "boolean" },
    "compression_threshold": { "type": "float", "minimum": 0, "maximum": 1 }
  }
}
